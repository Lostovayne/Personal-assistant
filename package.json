{
  "name": "personal-assistant",
  "type": "module",
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "hono": "node ./node_modules/@hono/cli/dist/cli.js",
    "check:routes": "node ./node_modules/@hono/cli/dist/cli.js routes src/app.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "1.0.0-rc.9",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
